{
  "name": "rails-mermaid_erd-tailwind",
  "private": true,
  "description": "Builds lib/templates/vendor/tailwind.css. Not shipped in the gem.",
  "scripts": {
    "build": "tailwindcss -i input.css -o ../../lib/templates/vendor/tailwind.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "tailwindcss": "4.3.3"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0"
  }
}
